[Unit]
Description=Qwen3.8-27B Cinference MTP on GPU 3
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/qwen38-4090/repos/qwen38-cinference-4090
Environment=QWEN38_CONTEXT=16384
Environment=QWEN38_DRAFT_TOKENS=7
ExecStart=%h/qwen38-4090/repos/qwen38-cinference-4090/run_qwen38_service.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=append:%h/qwen38-4090/logs/cinference-service.log
StandardError=append:%h/qwen38-4090/logs/cinference-service.log

[Install]
WantedBy=default.target
